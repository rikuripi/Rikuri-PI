{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "not": {
        "const": "run_00000000000000000000000000"
      },
      "minLength": 30,
      "maxLength": 30
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "logical_tick": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "type": "string",
      "enum": [
        "prepared",
        "dispatch_intent",
        "started",
        "denied",
        "reconciled",
        "cancel_requested",
        "cancel_observed",
        "captured",
        "verified",
        "released"
      ]
    },
    "producer_actor_id": {
      "type": "string",
      "pattern": "^actor_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "not": {
        "const": "actor_00000000000000000000000000"
      },
      "minLength": 32,
      "maxLength": 32
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "logical_tick",
    "kind",
    "producer_actor_id",
    "contract_sha256"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rikuri:fixture:adapter-event:v1",
  "$comment": "Synthetic simulator contract only, not registered production API/authentication."
}
