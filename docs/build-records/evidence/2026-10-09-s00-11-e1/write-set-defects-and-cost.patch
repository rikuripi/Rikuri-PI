diff --git a/apps/rikurid/tests/e1_defects.rs b/apps/rikurid/tests/e1_defects.rs
new file mode 100644
index 0000000..04b0701
--- /dev/null
+++ b/apps/rikurid/tests/e1_defects.rs
@@ -0,0 +1,171 @@
+//! E1 evidence harness (not part of the product; applied from
+//! docs/build-records/evidence/2026-10-09-s00-11-e1/). Planted kernel
+//! defects D1-D8 (switches in kernel.rs) and the cost of the write-set
+//! check on one long task.
+#![allow(clippy::unwrap_used, clippy::print_stdout)]
+use std::path::{Path, PathBuf};
+use std::time::Instant;
+
+use rikuri_api::{Request, Response, command};
+use rikuri_domain::{SystemClock, SystemIdSource};
+use rikurid::crash::NoCrash;
+use rikurid::{Idempotency, Kernel, KernelConfig};
+use serde_json::{Value, json};
+
+fn open(home: &Path) -> Kernel {
+    Kernel::open(
+        home,
+        KernelConfig {
+            ids: Box::new(SystemIdSource::new()),
+            clock: Box::new(SystemClock),
+            crash: Box::new(NoCrash),
+            idempotency: Idempotency::Enforced,
+        },
+    )
+    .unwrap()
+}
+
+fn keyed(k: &Kernel, c: &str, p: Value, key: &str) -> Response {
+    k.handle(&Request::new(c, p).with_idempotency_key(key))
+}
+
+fn res(r: &Response) -> Value {
+    r.result.clone().unwrap_or(Value::Null)
+}
+
+fn said(r: &Response) -> String {
+    match &r.error {
+        None => "ok".into(),
+        Some(e) => format!("refused ({}): {}", e.code.as_str(), e.message),
+    }
+}
+
+/// Task a (normal) and task b (private). Start a, try to start it again
+/// (a legitimate kernel refuses this), step a, complete a. With a defect
+/// switched on, the command that carries it should be refused before
+/// promotion, nothing quarantined, and task b unchanged.
+#[test]
+fn defects() {
+    let dir = tempfile::tempdir().unwrap();
+    let k = open(&dir.path().join("home"));
+    k.handle(&Request::new(command::SYSTEM_INIT, json!({})));
+    let a = res(&keyed(&k, command::TASK_CREATE, json!({"title": "a"}), "key-create-a001"));
+    keyed(
+        &k,
+        command::TASK_CREATE,
+        json!({"title": "b secret title", "privacy_class": "private"}),
+        "key-create-b001",
+    );
+    let task_b = |k: &Kernel| {
+        let s = res(&k.handle(&Request::new(command::STATE_SHOW, json!({}))));
+        let b = s["tasks"]
+            .as_array()
+            .and_then(|t| t.iter().find(|t| t["task_id"] != a["task_id"]).cloned())
+            .unwrap_or(Value::Null);
+        format!("privacy={} title={}", b["privacy_class"], b["title"])
+    };
+    let b_before = task_b(&k);
+    let s = keyed(
+        &k,
+        command::TASK_START,
+        json!({"task_id": a["task_id"], "expected_version": a["version"]}),
+        "key-start-a0001",
+    );
+    println!("DEF start: {}", said(&s));
+    if s.error.is_none() {
+        let s = res(&s);
+        let again = keyed(
+            &k,
+            command::TASK_START,
+            json!({"task_id": s["task_id"], "expected_version": s["version"]}),
+            "key-start-a0002",
+        );
+        println!("DEF second start: {}", said(&again));
+        let s = if again.error.is_none() { res(&again) } else { s };
+        let st = keyed(
+            &k,
+            command::TASK_STEP,
+            json!({"task_id": s["task_id"], "run_id": s["run_id"], "expected_version": s["version"]}),
+            "key-step-a00001",
+        );
+        println!("DEF step: {}", said(&st));
+        let cur = if st.error.is_none() { res(&st) } else { s };
+        let d = keyed(
+            &k,
+            command::TASK_COMPLETE,
+            json!({"task_id": cur["task_id"], "run_id": cur["run_id"],
+                   "expected_version": cur["version"],
+                   "outcome": "succeeded", "verification": "passed"}),
+            "key-done-a00001",
+        );
+        println!("DEF complete: {}", said(&d));
+    }
+    let report = k.check_consistency();
+    let next = keyed(&k, command::TASK_CREATE, json!({"title": "c"}), "key-create-c001");
+    let b_after = task_b(&k);
+    println!(
+        "DEF after: replay problems={} quarantined={} next create {} | task b {}",
+        report.problems.len(),
+        k.quarantined().is_some(),
+        said(&next),
+        if b_after == b_before {
+            format!("unchanged ({b_after})")
+        } else {
+            format!("CHANGED from {b_before} to {b_after}")
+        }
+    );
+}
+
+fn disk(name: &str) -> PathBuf {
+    let root = PathBuf::from(std::env::var("E1_DISK").expect("E1_DISK: a directory on a real disk"));
+    let h = root.join(name);
+    let _ = std::fs::remove_dir_all(&h);
+    std::fs::create_dir_all(&root).unwrap();
+    h
+}
+
+/// ms per `task.step` after `E1_N` earlier steps on one task. With
+/// `E1_NO_INDEX` the ledger's `events_by_task_type` index is dropped first.
+#[test]
+fn long_task_cost() {
+    let n: usize = std::env::var("E1_N").ok().and_then(|v| v.parse().ok()).unwrap_or(1000);
+    let k = open(&disk(&format!("long-{n}")));
+    k.handle(&Request::new(command::SYSTEM_INIT, json!({})));
+    let t = res(&keyed(&k, command::TASK_CREATE, json!({"title": "long"}), "key-create-long1"));
+    let mut cur = res(&keyed(
+        &k,
+        command::TASK_START,
+        json!({"task_id": t["task_id"], "expected_version": t["version"]}),
+        "key-start-long01",
+    ));
+    let step = |k: &Kernel, cur: &Value, key: String| {
+        res(&keyed(
+            k,
+            command::TASK_STEP,
+            json!({"task_id": cur["task_id"], "run_id": cur["run_id"], "expected_version": cur["version"]}),
+            &key,
+        ))
+    };
+    for i in 0..n {
+        cur = step(&k, &cur, format!("key-grow-{i:09}"));
+    }
+    let index = std::env::var_os("E1_NO_INDEX").is_none();
+    if !index {
+        k.store()
+            .write(|tx| {
+                tx.execute_batch("DROP INDEX events_by_task_type")
+                    .map_err(rikuri_storage::StorageError::from)
+            })
+            .unwrap();
+    }
+    let m = 50;
+    let start = Instant::now();
+    for i in 0..m {
+        cur = step(&k, &cur, format!("key-meas-{i:09}"));
+        assert!(!cur.is_null(), "a measured step failed");
+    }
+    println!(
+        "COST steps_before={n} index={index} ms_per_step={:.3}",
+        start.elapsed().as_secs_f64() * 1000.0 / f64::from(m)
+    );
+}
