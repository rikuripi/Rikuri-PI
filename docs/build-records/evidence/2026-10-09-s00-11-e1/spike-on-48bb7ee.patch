+/// E1 spike (scratch): the same comparisons, scoped to the tasks a command
+/// touched: their own events (indexed by task), their runs, their counts.
+pub(crate) fn consistency_for_tasks(
+    tx: &Tx<'_>,
+    touched: &[TaskId],
+) -> Result<Vec<String>, StorageError> {
+    let mut problems = vec![];
+    let mut events: HashMap<EventId, Event> = HashMap::new();
+    let mut tasks_owned = vec![];
+    let mut runs: HashMap<RunId, Run> = HashMap::new();
+    let runs_repo = SqliteRepository::<Run>::new();
+    for &id in touched {
+        let evs = rikuri_ledger::by_task(tx, id).map_err(|e| StorageError::Corrupt {
+            kind: "event",
+            id: id.to_string(),
+            reason: e.to_string(),
+        })?;
+        let (mut created, mut stepped, mut started) = (0u32, 0u32, 0u32);
+        for e in &evs {
+            match e.event_type.as_str() {
+                "task.created" => created += 1,
+                "task.stepped" => stepped += 1,
+                "run.started" => started += 1,
+                _ => {}
+            }
+            if let Some(r) = e.run_id
+                && !runs.contains_key(&r)
+                && let Some(run) = runs_repo.get(tx, r)?
+            {
+                runs.insert(r, run.value);
+            }
+            events.insert(e.event_id, e.clone());
+        }
+        let Some(task) = SqliteRepository::<Task>::new().get(tx, id)? else {
+            problems.push(format!("ledger references task {id}, which does not exist"));
+            continue;
+        };
+        let task = task.value;
+        if created != 1 {
+            problems.push(format!("task {id} has {created} task.created events, expected 1"));
+        }
+        if stepped != task.steps_completed {
+            problems.push(format!("task {id} records {} steps but the ledger has {stepped}", task.steps_completed));
+        }
+        if started != task.runs {
+            problems.push(format!("task {id} records {} runs but the ledger has {started}", task.runs));
+        }
+        for r in [task.current_run, task.last_run].into_iter().flatten() {
+            if !runs.contains_key(&r)
+                && let Some(run) = runs_repo.get(tx, r)?
+            {
+                runs.insert(r, run.value);
+            }
+        }
+        tasks_owned.push(task);
+    }
+    for run in runs.values() {
+        check_run(run, &events, &mut problems);
+    }
+    check_run_events(&runs, &events, &mut problems);
+    let tasks: HashMap<TaskId, &Task> = tasks_owned.iter().map(|t| (t.id, t)).collect();
+    // runs of these tasks only: a run whose task is outside the scope is not ours to judge
+    let ours: HashMap<RunId, Run> = runs.into_iter().filter(|(_, r)| tasks.contains_key(&r.task_id)).collect();
+    check_task_runs(&tasks, &ours, &mut problems);
+    Ok(problems)
+}
