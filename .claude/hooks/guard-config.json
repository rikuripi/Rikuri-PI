    {"tool": "Bash", "input": {"command": "gh auth status -t"}, "expect": "ask"},
    {"tool": "Bash", "input": {"command": "gh auth status --show-token"}, "expect": "ask"},
    {"tool": "Bash", "input": {"command": "grep -rn 'client_secret' doc"}, "expect": "allow"},
