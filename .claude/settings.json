{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git worktree list:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git check-ignore:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo tree:*)",
      "Bash(python3 -m unittest discover -s .claude/hooks:*)",
      "Bash(python3 .claude/hooks/guard.py fix-lock status)",
      "Bash(python3 .claude/hooks/guard.py profile)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh auth status)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(sha256sum:*)"
    ]
  },
  "enabledPlugins": {
    "agentic-sdlc@synced": false,
    "agent-memory@synced": false,
    "evermuse@synced": false,
    "agent-sdk-dev@synced": false,
    "agent-context-kit@synced": false,
    "zapier@synced": false
  }
}
